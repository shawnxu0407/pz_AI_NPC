            { "x": 106, "y": 200 },
            { "x": 94, "y": 198 },
            { "x": 102, "y": 206 }
          ],
          "nearby_items": [],
          "companion": { "health": 30, "x": 100, "y": 200, "current_action": "follow" },
          "player_position": { "x": 100, "y": 200 }
        }
      }
    },
    {
      "name": "player_wait",
